<?php

/**
 * @file
 * Health Stats module — exposes site statistics as a JSON endpoint.
 */

/**
 * Implements hook_permission().
 */
function healthstats_permission() {
  return array(
    'view healthstats' => array(
      'title' => t('View health statistics'),
      'description' => t('Access the JSON site statistics endpoint at api/healthstats.'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function healthstats_menu() {
  $items = array();

  $items['api/healthstats'] = array(
    'title' => 'Health statistics',
    'page callback' => 'healthstats_stats',
    'access arguments' => array('view healthstats'),
    'delivery callback' => 'healthstats_deliver_json',
    'type' => MENU_CALLBACK,
  );

  return $items;
}

/**
 * Page callback: builds the site statistics.
 *
 * Returns a plain data array; turning it into a JSON response is the job of
 * the delivery callback registered for this menu item.
 *
 * @return array
 *   An associative array with the keys 'users' (number of active users) and
 *   'nodes' (number of published nodes).
 */
function healthstats_stats() {
  $users = db_query('SELECT COUNT(uid) FROM {users} WHERE status = :status', array(':status' => 1))->fetchField();
  $nodes = db_query('SELECT COUNT(nid) FROM {node} WHERE status = :status', array(':status' => 1))->fetchField();

  return array(
    'users' => (int) $users,
    'nodes' => (int) $nodes,
  );
}

/**
 * Delivery callback: sends a page callback result to the browser as JSON.
 *
 * Menu error conditions (access denied, not found, site offline) arrive here as
 * integer status constants rather than as data. Those are handed back to
 * Drupal's default HTML delivery, so the usual 403/404 responses — status line
 * included — are produced.
 *
 * @param mixed $page_callback_result
 *   The result of the page callback, or a menu status constant.
 */
function healthstats_deliver_json($page_callback_result) {
  if (!is_array($page_callback_result)) {
    drupal_deliver_html_page($page_callback_result);
    return;
  }

  drupal_json_output($page_callback_result);
  drupal_page_footer();
}
