<?php

/**
 * @file
 * Health Stats module — exposes a JSON endpoint with site statistics.
 */

/**
 * Implements hook_permission().
 */
function healthstats_permission() {
  return array(
    'view healthstats' => array(
      'title' => t('View health statistics'),
      'description' => t('Access the JSON statistics endpoint at api/healthstats.'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function healthstats_menu() {
  $items = array();

  $items['api/healthstats'] = array(
    'title' => 'Health statistics',
    'page callback' => 'healthstats_stats',
    'access arguments' => array('view healthstats'),
    'delivery callback' => 'healthstats_deliver_json',
    'type' => MENU_CALLBACK,
  );

  return $items;
}

/**
 * Page callback: builds the site statistics.
 *
 * The data is returned as a plain array; converting it to JSON and sending it
 * to the browser is the job of the delivery callback.
 *
 * @return array
 *   An associative array with the number of active users and published nodes.
 */
function healthstats_stats() {
  $users = db_select('users', 'u')
    ->condition('u.status', 1)
    ->countQuery()
    ->execute()
    ->fetchField();

  $nodes = db_select('node', 'n')
    ->condition('n.status', 1)
    ->countQuery()
    ->execute()
    ->fetchField();

  return array(
    'users' => (int) $users,
    'nodes' => (int) $nodes,
  );
}

/**
 * Delivery callback: sends the page callback result to the browser as JSON.
 *
 * Menu status constants (access denied, not found, site offline) are handed
 * back to Drupal's regular HTML delivery, so that the proper HTTP status code
 * and error page are produced instead of a JSON-encoded integer.
 *
 * @param array|int $page_callback_result
 *   The result of the page callback, or a menu status constant.
 */
function healthstats_deliver_json($page_callback_result) {
  if (is_int($page_callback_result)) {
    drupal_deliver_html_page($page_callback_result);
    return;
  }

  drupal_json_output($page_callback_result);
}
